{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "module": "commonjs",
    "types": ["node"]
  },
  "include": [
    "src/main.ts",
    "src/app.module.ts",
    "src/common/**/*.ts",
    "src/modules/auth/**/*.ts",
    "src/modules/matricula/**/*.ts",
    "src/modules/documento/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.spec.ts"
  ]
}