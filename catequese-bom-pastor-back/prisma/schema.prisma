// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Administrador {
  id             String   @id @default(uuid()) @map("cod_administrador")
  email          String   @unique @map("dsc_email")
  nome           String   @map("dsc_nome")
  telefone       String?  @map("dsc_telefone")
  senha          String   @map("dsc_senha")
  primeiroAcesso Boolean  @default(false) @map("ind_primeiro_acesso")
  criadoEm       DateTime @default(now()) @map("dat_criado_em")
  atualizadoEm   DateTime @updatedAt @map("dat_atualizado_em")

  preMatriculasDecididas         PreMatricula[]
  inscricoesCatequistasDecididas InscricaoCatequista[]
  turmasCriadas                  Turma[]               @relation("createdBy")

  @@map("administrador")
}

model Responsavel {
  id             String   @id @default(uuid()) @map("cod_responsavel")
  email          String   @unique @map("dsc_email")
  nome           String   @map("dsc_nome")
  telefone       String?  @map("dsc_telefone")
  senha          String   @map("dsc_senha")
  primeiroAcesso Boolean  @default(false) @map("ind_primeiro_acesso")
  criadoEm       DateTime @default(now())
  updatedAt      DateTime @updatedAt

  catequizandos Catequizando[]
  inscricoes    Inscricao[]
  pagamentos    Pagamento[]

  @@map("responsaveis")
}

model Turma {
  id              String   @id @default(uuid()) @map("cod_turma")
  nome            String   @map("dsc_nome")
  ano             Int      @map("num_ano")
  horario         String?  @map("dsc_horario")
  sala            String?  @map("dsc_sala")
  administradorId String   @map("cod_administrador")
  criadoEm        DateTime @default(now())
  updatedAt       DateTime @updatedAt

  catequistasTurma TurmaCatequista[]
  catequizandos    Catequizando[]
  inscricoes       Inscricao[]
  eventos          Evento[]
  materiais        Material[]
  documentos       Documento[]       @relation("DocumentosTurma")
  administrador    Administrador     @relation("createdBy", fields: [administradorId], references: [id])

  @@map("turmas")
}

model Catequizando {
  id             String                  @id @default(uuid()) @map("cod_catequizando")
  nome           String                  @map("dsc_nome")
  dataNascimento DateTime                @map("dat_nascimento")
  dataBatismo    DateTime?               @map("dat_batismo")
  cpf            String?                 @map("nr_cpf")
  email          String?                 @map("dsc_email")
  telefone       String?                 @map("dsc_telefone")
  endereco       String?                 @map("dsc_endereco")
  turmaId        String?                 @map("cod_turma")
  turma          Turma?                  @relation(fields: [turmaId], references: [id], onDelete: SetNull)
  responsavelId  String                  @map("cod_responsavel")
  responsavel    Responsavel             @relation(fields: [responsavelId], references: [id], onDelete: Cascade)
  inscricoes     Inscricao[]
  documentos     CatequizandoDocumento[]
  observacoes    String?                 @map("dsc_observacoes")
  criadoEm       DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@map("catequizandos")
}

model PreMatricula {
  id                     String    @id @default(uuid()) @map("cod_pre_matricula")
  status                 String    @map("dsc_status")
  nomeCatequizando       String    @map("dsc_nome_catequizando")
  alergiasProblemasSaude String?   @map("dsc_alergias_problemas_saude")
  dataNascimento         DateTime  @map("dat_nascimento")
  nomePais               String    @map("dsc_nome_pais")
  email                  String    @map("dsc_email")
  telefone               String    @map("dsc_telefone")
  sacramentosPais        String?   @map("dsc_sacramentos_pais")
  CertificadoBatismo     String?   @map("dsc_certificado_batismo")
  ComprovanteEndereco    String?   @map("dsc_comprovante_endereco")
  CertidaoDeNascimento   String?   @map("dsc_certidao_nascimento")
  decisaoEm              DateTime? @map("dat_decisao")
  decisaoPorId           String?   @map("cod_administrador")
  observacoesAdmin       String?
  criadoEm               DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  decisaoPor Administrador? @relation(fields: [decisaoPorId], references: [id], onDelete: SetNull)

  @@map("pre_matriculas")
}

model InscricaoCatequista {
  id                    String    @id @default(uuid()) @map("cod_inscricao_catequista")
  status                String    @map("dsc_status")
  nome                  String    @map("dsc_nome")
  dataNascimento        DateTime  @map("dat_nascimento")
  dataBatismo           DateTime? @map("dat_batismo")
  email                 String    @map("dsc_email")
  telefone              String    @map("dsc_telefone")
  casado                Boolean    @map("flg_casado")
  casadaIgrejaCatolica  Boolean?   @map("flg_casada_igreja_catolica")
  sacramentos           String?   @map("dsc_sacramentos")
  alergias              String?   @map("dsc_alergias")
  ComprovanteResidencia String?   @map("dsc_comprovante_residencia")
  DocumentoCpf          String?   @map("dsc_documento_cpf")
  decisaoEm             DateTime? @map("dat_decisao")
  decisaoPorId          String?   @map("cod_administrador")
  observacoesAdmin      String?   @map("dsc_observacoes_admin")
  criadoEm              DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  decisaoPor Administrador? @relation(fields: [decisaoPorId], references: [id], onDelete: SetNull)

  @@map("inscricoes_catequistas")
}

model CatequizandoDocumento {
  id             String       @id @default(uuid()) @map("cod_documento")
  catequizandoId String       @map("cod_catequizando")
  catequizando   Catequizando @relation(fields: [catequizandoId], references: [id], onDelete: Cascade)
  tipo           String       @map("dsc_tipo")
  status         Boolean      @default(false)
  uploadDate     DateTime?    @map("dat_upload")
  fileUrl        String?      @map("dsc_file_url")
  criadoEm       DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([catequizandoId, tipo])
  @@map("catequizando_documentos")
}

model Inscricao {
  id             String       @id @default(uuid()) @map("cod_inscricao")
  catequizandoId String       @map("cod_catequizando")
  catequizando   Catequizando @relation(fields: [catequizandoId], references: [id], onDelete: Cascade)
  turmaId        String       @map("cod_turma")
  turma          Turma        @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  responsavelId  String       @map("cod_responsavel")
  responsavel    Responsavel  @relation(fields: [responsavelId], references: [id], onDelete: Cascade)
  status         String       @map("dsc_status")
  documentosUrl  String[]
  observacoes    String?      @map("dsc_observacoes")
  criadoEm       DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  pagamentos     Pagamento[]

  @@unique([catequizandoId, turmaId])
  @@map("inscricoes")
}

model Pagamento {
  id            String       @id @default(uuid()) @map("cod_pagamento")
  inscricaoId   String?
  inscricao     Inscricao?   @relation(fields: [inscricaoId], references: [id], onDelete: SetNull)
  responsavelId String?
  responsavel   Responsavel? @relation(fields: [responsavelId], references: [id], onDelete: SetNull)
  valor         Float
  metodo        String?      @map("dsc_metodo")
  status        String?      @map("dsc_status")
  receiptUrl    String?      @map("dsc_receipt_url")
  dataPagamento DateTime?    @map("dat_pagamento")
  descricao     String?      @map("dsc_descricao")
  criadoEm      DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@map("pagamentos")
}

model Material {
  id           String   @id @default(uuid()) @map("cod_material")
  titulo       String   @map("dsc_titulo")
  descricao    String?  @map("dsc_descricao")
  fileUrl      String   @map("dsc_file_url")
  turmaId      String?  @map("cod_turma")
  turma        Turma?   @relation(fields: [turmaId], references: [id], onDelete: SetNull)
  visibilidade String   @default("geral")
  criadoEm     DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("materiais")
}

model Catequista {
  id             String            @id @default(uuid()) @map("cod_catequista")
  nome           String            @map("dsc_nome")
  email          String            @unique @map("dsc_email")
  senha          String            @map("pws_senha")
  telefone       String?           @map("dsc_telefone")
  endereco       String?           @map("dsc_endereco")
  bio            String?           @map("dsc_bio")
  primeiroAcesso Boolean           @default(false)
  turmas         TurmaCatequista[]
  criadoEm       DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@map("catequistas")
}

model TurmaCatequista {
  id           String     @id @default(uuid()) @map("cod_turma_catequista")
  turmaId      String     @map("cod_turma")
  catequistaId String     @map("cod_catequista")
  categoria    String     @map("dsc_categoria")
  turma        Turma      @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  catequista   Catequista @relation(fields: [catequistaId], references: [id], onDelete: Cascade)
  criadoEm     DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([turmaId, catequistaId])
  @@map("turmas_catequistas")
}

model Documento {
  id           String   @id @default(uuid()) @map("cod_documento")
  titulo       String   @map("dsc_titulo")
  descricao    String?  @map("dsc_descricao")
  fileUrl      String   @map("dsc_file_url")
  visibilidade String   @default("parent") // "parent", "turma", "geral"
  turmaId      String?  @map("cod_turma")
  turma        Turma?   @relation("DocumentosTurma", fields: [turmaId], references: [id], onDelete: SetNull)
  criadoEm     DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("documentos")
}

model Evento {
  id          String    @id @default(uuid()) @map("cod_evento")
  titulo      String    @map("dsc_titulo")
  descricao   String?   @map("dsc_descricao")
  data        DateTime
  dataFim     DateTime? @map("dat_fim")
  horaInicio  String?   @map("hor_inicio")
  horaFim     String?   @map("hor_fim")
  local       String?   @map("dsc_local")
  categoria   String    @default("ENCONTRO") @map("dsc_categoria")
  cor         String?   @map("dsc_cor")
  recorrencia String?   @map("dsc_recorrencia") // DIARIO, SEMANAL, MENSAL, ANUAL, null
  tipo        String    @default("GERAL")
  turmaId     String?   @map("cod_turma")
  turma       Turma?    @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  criadoEm    DateTime  @default(now()) @map("dat_criado_em")
  updatedAt   DateTime  @updatedAt @map("dat_atualizado_em")

  @@map("eventos")
}

model Galeria {
  id           String   @id @default(uuid()) @map("cod_galeria")
  titulo       String   @map("dsc_titulo")
  descricao    String?  @map("dsc_descricao")
  visibilidade String   @default("geral")
  imagens      Imagem[]
  criadoEm     DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("galerias")
}

model Photo {
  id          String   @id @default(uuid())
  title       String
  description String?
  imageUrl    String
  storageKey  String
  isActive    Boolean  @default(true)
  criadoEm    DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("photos")
}

model Imagem {
  id        String   @id @default(uuid()) @map("cod_imagem")
  galeiraId String   @map("cod_galeria")
  galeria   Galeria  @relation(fields: [galeiraId], references: [id], onDelete: Cascade)
  fileUrl   String   @map("dsc_file_url")
  titulo    String?  @map("dsc_titulo")
  criadoEm  DateTime @default(now())

  @@map("imagens")
}

model Musica {
  id          String   @id @default(uuid()) @map("cod_musica")
  titulo      String   @map("dsc_titulo")
  autor       String?  @map("dsc_autor")
  linkExterno String?  @map("txt_link_externo")
  notas       String?  @map("dsc_notas")
  criadoEm    DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("musicas")
}

enum DestinatarioTipo {
  ADMINISTRADOR
  CATEQUISTA
  RESPONSAVEL
  TURMA
}

model Mensagem {
  id              String              @id @default(uuid()) @map("cod_mensagem")
  remetenteTipo   DestinatarioTipo    @map("dsc_remetente_tipo")
  remetenteId     String              @map("cod_remetente")
  assunto         String              @map("dsc_assunto")
  conteudo         String              @map("txt_conteudo")
  lida            Boolean             @default(false) @map("ind_lida")
  lidaEm          DateTime?           @map("dat_lida_em")
  criadoEm        DateTime            @default(now()) @map("dat_criado_em")
  atualizadoEm    DateTime            @updatedAt @map("dat_atualizado_em")

  destinatarios   MensagemDestinatario[]

  @@map("mensagens")
}

model MensagemDestinatario {
  id              String           @id @default(uuid()) @map("cod_mensagem_destinatario")
  mensagemId      String           @map("cod_mensagem")
  mensagem         Mensagem         @relation(fields: [mensagemId], references: [id], onDelete: Cascade)
  destinatarioTipo DestinatarioTipo @map("dsc_destinatario_tipo")
  destinatarioId   String           @map("cod_destinatario")
  lida            Boolean          @default(false) @map("ind_lida")
  lidaEm          DateTime?        @map("dat_lida_em")
  criadoEm        DateTime         @default(now()) @map("dat_criado_em")

  @@map("mensagens_destinatarios")
}

model Notificacao {
  id              String           @id @default(uuid()) @map("cod_notificacao")
  usuarioTipo     DestinatarioTipo @map("dsc_usuario_tipo")
  usuarioId       String           @map("cod_usuario")
  titulo          String           @map("dsc_titulo")
  descricao       String           @map("dsc_descricao")
  tipo            String           @map("dsc_tipo") // INFO, AVISO, URGENTE, SUCESSO, ERRO
  prioridade      String           @default("NORMAL") @map("dsc_prioridade") // BAIXA, NORMAL, ALTA, URGENTE
  lida            Boolean          @default(false) @map("ind_lida")
  lidaEm          DateTime?        @map("dat_lida_em")
  linkRelacionado String?          @map("txt_link_relacionado")
  criadoEm        DateTime         @default(now()) @map("dat_criado_em")

  @@map("notificacoes")
}

model LojaItem {
  id        String      @id @default(uuid()) @map("cod_loja_item")
  nome      String      @map("dsc_nome")
  descricao String?     @map("dsc_descricao")
  preco     Float       @map("vlr_preco")
  estoque   Int         @map("qtd_estoque")
  imagemUrl String?     @map("dsc_imagem_url")
  ordens    OrdemLoja[] @relation("ItensOrdem")
  criadoEm  DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@map("loja_items")
}

model OrdemLoja {
  id            String     @id @default(uuid()) @map("cod_ordem_loja")
  responsavelId String     @map("cod_responsavel")
  itens         LojaItem[] @relation("ItensOrdem")
  total         Float      @map("vlr_total")
  status        String     @default("pending")
  pagamentoId   String?    @map("cod_pagamento")
  criadoEm      DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@map("ordem_loja")
}
