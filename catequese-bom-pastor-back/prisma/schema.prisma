// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Administrador {
  id             String   @id @default(uuid()) @map("cod_administrador")
  email          String   @unique @map("dsc_email")
  nome           String   @map("dsc_nome")
  telefone       String?  @map("dsc_telefone")
  senha          String   @map("dsc_senha")
  primeiroAcesso Boolean  @default(false) @map("ind_primeiro_acesso")
  criadoEm       DateTime @default(now()) @map("dat_criado_em")
  atualizadoEm   DateTime @updatedAt @map("dat_atualizado_em")

  turmasCriadas                  Turma[]               @relation("createdBy")
  preMatriculasDecididas         PreMatricula[]
  inscricoesCatequistasDecididas InscricaoCatequista[]

  @@map("administrador")
}

model Responsavel {
  id             String         @id @default(uuid()) @map("cod_responsavel")
  email          String         @unique @map("dsc_email")
  nome           String      @map("dsc_nome")
  telefone       String?    @map("dsc_telefone")
  senha          String     @map("dsc_senha")
  primeiroAcesso Boolean        @default(false) @map("ind_primeiro_acesso")
  catequizandos  Catequizando[] 
  inscricoes     Inscricao[]
  pagamentos     Pagamento[]
  criadoEm       DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@map("responsaveis")
}

model Turma {
  id               String            @id @default(uuid()) @map("cod_turma")
  nome             String
  ano              Int
  horario          String?
  sala             String?
  administradorId  String
  administrador    Administrador     @relation("createdBy", fields: [administradorId], references: [id])
  catequistasTurma TurmaCatequista[]
  catequizandos    Catequizando[]
  inscricoes       Inscricao[]
  eventos          Evento[]
  materiais        Material[]
  documentos       Documento[]       @relation("DocumentosTurma")
  criadoEm         DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@map("turmas")
}

model Catequizando {
  id             String                  @id @default(uuid()) @map("cod_catequizando")
  nome           String
  dataNascimento DateTime
  dataBatismo    DateTime?
  cpf            String?
  email          String?
  telefone       String?
  endereco       String?
  turmaId        String?
  turma          Turma?                  @relation(fields: [turmaId], references: [id], onDelete: SetNull)
  responsavelId  String
  responsavel    Responsavel             @relation(fields: [responsavelId], references: [id], onDelete: Cascade)
  inscricoes     Inscricao[]
  documentos     CatequizandoDocumento[]
  observacoes    String?
  criadoEm       DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@map("catequizandos")
}

enum PreMatriculaStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InscricaoCatequistaStatus {
  PENDING
  APPROVED
  REJECTED
}

model PreMatricula {
  id                     String             @id @default(uuid()) @map("cod_pre_matricula")
  status                 PreMatriculaStatus @default(PENDING)
  nomeCatequizando       String
  alergiasProblemasSaude String?
  dataNascimento         DateTime
  nomePais               String
  email                  String
  telefone               String
  sacramentosPais        String?
  CertificadoBatismo     String?
  ComprovanteEndereco    String?
  CertidaoDeNascimento   String?
  decisaoEm              DateTime?
  decisaoPorId           String?
  decisaoPor             Administrador?     @relation(fields: [decisaoPorId], references: [id], onDelete: SetNull)
  observacoesAdmin       String?
  criadoEm               DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@map("pre_matriculas")
}

model InscricaoCatequista {
  id                    String                    @id @default(uuid()) @map("cod_inscricao_catequista")
  status                InscricaoCatequistaStatus @default(PENDING)
  nome                  String
  dataNascimento        DateTime
  dataBatismo           DateTime?
  email                 String
  telefone              String
  casado                String
  casadaIgrejaCatolica  String?
  sacramentos           String?
  alergias              String?
  ComprovanteResidencia String?
  DocumentoCpf          String?
  decisaoEm             DateTime?
  decisaoPorId          String?
  decisaoPor            Administrador?            @relation(fields: [decisaoPorId], references: [id], onDelete: SetNull)
  observacoesAdmin      String?
  criadoEm              DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  @@map("inscricoes_catequistas")
}

enum InscricaoStatus {
  SUBMITTED
  APPROVED
  REJECTED
}

enum TipoDocumentoCatequizando {
  CERTIDAO_NASCIMENTO
  CPF
  CARTEIRA_VACINA
}

model CatequizandoDocumento {
  id             String                    @id @default(uuid()) @map("cod_documento")
  catequizandoId String
  catequizando   Catequizando              @relation(fields: [catequizandoId], references: [id], onDelete: Cascade)
  tipo           TipoDocumentoCatequizando
  status         Boolean                   @default(false)
  uploadDate     DateTime?
  fileUrl        String?
  criadoEm       DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@unique([catequizandoId, tipo])
  @@map("catequizando_documentos")
}

model Inscricao {
  id             String          @id @default(uuid()) @map("cod_inscricao")
  catequizandoId String
  catequizando   Catequizando    @relation(fields: [catequizandoId], references: [id], onDelete: Cascade)
  turmaId        String
  turma          Turma           @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  responsavelId  String
  responsavel    Responsavel     @relation(fields: [responsavelId], references: [id], onDelete: Cascade)
  status         InscricaoStatus @default(SUBMITTED)
  documentosUrl  String[]
  observacoes    String?
  criadoEm       DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  pagamentos     Pagamento[]

  @@unique([catequizandoId, turmaId])
  @@map("inscricoes")
}

enum PaymentMethod {
  CASH
  PIX
  CARD
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  RECEIVED
  CANCELLED
}

model Pagamento {
  id            String        @id @default(uuid()) @map("cod_pagamento")
  inscricaoId   String?
  inscricao     Inscricao?    @relation(fields: [inscricaoId], references: [id], onDelete: SetNull)
  responsavelId String?
  responsavel   Responsavel?  @relation(fields: [responsavelId], references: [id], onDelete: SetNull)
  valor         Float
  metodo        PaymentMethod
  status        PaymentStatus @default(PENDING)
  receiptUrl    String?
  dataPagamento DateTime?
  descricao     String?
  criadoEm      DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("pagamentos")
}

model Material {
  id           String   @id @default(uuid()) @map("cod_material")
  titulo       String
  descricao    String?
  fileUrl      String
  turmaId      String? // NULL = material geral
  turma        Turma?   @relation(fields: [turmaId], references: [id], onDelete: SetNull)
  visibilidade String   @default("geral") // "geral" ou "turma"
  criadoEm     DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("materiais")
}

model Catequista {
  id             String            @id @default(uuid()) @map("cod_catequista")
  nome           String
  email          String            @unique
  senha          String
  telefone       String?
  endereco       String?
  bio            String?
  primeiroAcesso Boolean           @default(false)
  turmas         TurmaCatequista[]
  criadoEm       DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@map("catequistas")
}

enum CategoriaCatequistaTurma {
  CATEQUISTA
  AUXILIAR
}

model TurmaCatequista {
  id           String                   @id @default(uuid()) @map("cod_turma_catequista")
  turmaId      String
  catequistaId String
  categoria    CategoriaCatequistaTurma @default(CATEQUISTA)
  turma        Turma                    @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  catequista   Catequista               @relation(fields: [catequistaId], references: [id], onDelete: Cascade)
  criadoEm     DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@unique([turmaId, catequistaId])
  @@map("turmas_catequistas")
}

model Documento {
  id           String   @id @default(uuid()) @map("cod_documento")
  titulo       String
  descricao    String?
  fileUrl      String
  visibilidade String   @default("parent") // "parent", "turma", "geral"
  turmaId      String?
  turma        Turma?   @relation("DocumentosTurma", fields: [turmaId], references: [id], onDelete: SetNull)
  criadoEm     DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("documentos")
}

enum TipoEvento {
  TURMA
  GERAL
}

model Evento {
  id        String     @id @default(uuid()) @map("cod_evento")
  titulo    String
  descricao String?
  data      DateTime
  tipo      TipoEvento @default(GERAL)
  turmaId   String?
  turma     Turma?     @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  criadoEm  DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("eventos")
}

model Galeria {
  id           String   @id @default(uuid()) @map("cod_galeria")
  titulo       String
  descricao    String?
  visibilidade String   @default("geral")
  imagens      Imagem[]
  criadoEm     DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("galerias")
}

model Imagem {
  id        String   @id @default(uuid()) @map("cod_imagem")
  galeiraId String
  galeria   Galeria  @relation(fields: [galeiraId], references: [id], onDelete: Cascade)
  fileUrl   String
  titulo    String?
  criadoEm  DateTime @default(now())

  @@map("imagens")
}

model Musica {
  id          String   @id @default(uuid()) @map("cod_musica")
  titulo      String
  autor       String?
  linkExterno String?
  notas       String?
  criadoEm    DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("musicas")
}

model LojaItem {
  id        String      @id @default(uuid()) @map("cod_loja_item")
  nome      String
  descricao String?
  preco     Float
  estoque   Int
  imagemUrl String?
  ordens    OrdemLoja[] @relation("ItensOrdem")
  criadoEm  DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@map("loja_items")
}

model OrdemLoja {
  id            String     @id @default(uuid()) @map("cod_ordem_loja")
  responsavelId String
  itens         LojaItem[] @relation("ItensOrdem")
  total         Float
  status        String     @default("pending")
  pagamentoId   String?
  criadoEm      DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@map("ordem_loja")
}
