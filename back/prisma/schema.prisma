generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum TipoPasswordSetup {
  PRIMEIRO_ACESSO
  RESET_SENHA
}

model Usuario {
  id             BigInt    @id @default(autoincrement())
  nome           String    @db.VarChar(150)
  email          String    @unique(map: "email") @db.VarChar(150)
  senha          String    @db.VarChar(255)
  telefone       String?   @db.VarChar(20)
  ativo          Boolean?  @default(true)
  dataCadastro   DateTime? @default(now()) @map("data_cadastro") @db.DateTime(0)
  ultimoAcesso   DateTime? @map("ultimo_acesso") @db.DateTime(0)
  primeiroAcesso Boolean   @default(false) @map("primeiro_acesso")

  perfis                    UsuarioPerfil[]
  responsavel               Responsavel?
  catequista                Catequista?
  tokensPasswordSetup       PasswordSetupToken[]
  decisoesMatricula         MatriculaDecisao[]
  disponibilizacoesConteudo DisponibilizacaoConteudo[]
  comunicados               Comunicado[]
  mensagensEnviadas         Mensagem[]                 @relation("MensagemRemetente")
  mensagensRecebidas        Mensagem[]                 @relation("MensagemDestinatario")

  @@map("usuario")
}

model Perfil {
  id        BigInt          @id @default(autoincrement())
  nome      String          @unique(map: "nome") @db.VarChar(50)
  descricao String?         @db.VarChar(255)
  usuarios  UsuarioPerfil[]

  @@map("perfil")
}

model UsuarioPerfil {
  usuarioId BigInt  @map("usuario_id")
  perfilId  BigInt  @map("perfil_id")
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade, map: "fk_usuario_perfil_usuario")
  perfil    Perfil  @relation(fields: [perfilId], references: [id], onDelete: Cascade, map: "fk_usuario_perfil_perfil")

  @@id([usuarioId, perfilId])
  @@index([perfilId], map: "fk_usuario_perfil_perfil")
  @@map("usuario_perfil")
}

model Responsavel {
  id         BigInt  @id @default(autoincrement())
  usuarioId  BigInt  @unique(map: "usuario_id") @map("usuario_id")
  cpf        String  @db.VarChar(14)
  parentesco String? @db.VarChar(50)
  usuario    Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade, map: "fk_responsavel_usuario")

  matriculas    Matricula[]
  catequizandos Catequizando[]

  @@map("responsavel")
}

model Catequista {
  id           BigInt    @id @default(autoincrement())
  usuarioId    BigInt    @unique(map: "usuario_id") @map("usuario_id")
  formacao     String?   @db.VarChar(150)
  dataIngresso DateTime? @map("data_ingresso") @db.Date
  usuario      Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade, map: "fk_catequista_usuario")

  turmas                    TurmaCatequista[]
  disponibilizacoesConteudo DisponibilizacaoConteudo[]

  @@map("catequista")
}

model Matricula {
  id                             BigInt           @id @default(autoincrement())
  dataSolicitacao                DateTime?        @default(now()) @map("data_solicitacao") @db.DateTime(0)
  status                         String           @db.VarChar(30)
  observacao                     String?          @db.Text
  dataAprovacao                  DateTime?        @map("data_aprovacao") @db.DateTime(0)
  responsavelId                  BigInt?          @map("responsavel_id")
  responsavelNome                String           @map("responsavel_nome") @db.VarChar(150)
  responsavelCpf                 String           @map("responsavel_cpf") @db.VarChar(14)
  responsavelParentesco          String           @map("responsavel_parentesco") @db.VarChar(50)
  responsavelDataNascimento      DateTime         @map("responsavel_data_nascimento") @db.Date
  responsavelTelefone            String           @map("responsavel_telefone") @db.VarChar(20)
  responsavelWhatsapp            String           @map("responsavel_whatsapp") @db.VarChar(20)
  responsavelEmail               String           @map("responsavel_email") @db.VarChar(150)
  catequizandoNome               String           @map("catequizando_nome") @db.VarChar(150)
  catequizandoDataNascimento     DateTime         @map("catequizando_data_nascimento") @db.Date
  catequizandoEndereco           String           @map("catequizando_endereco") @db.Text
  catequizandoTelefoneEmergencia String           @map("catequizando_telefone_emergencia") @db.VarChar(20)
  etapaId                        BigInt           @map("etapa_id")
  responsavel                    Responsavel?     @relation(fields: [responsavelId], references: [id], onDelete: SetNull, map: "fk_matricula_responsavel")
  etapa                          EtapaCatequetica @relation(fields: [etapaId], references: [id], onDelete: NoAction, map: "fk_matricula_etapa")

  documentos   Documento[]
  decisoes     MatriculaDecisao[]
  catequizando Catequizando?

  @@index([responsavelId], map: "fk_matricula_responsavel")
  @@index([etapaId], map: "fk_matricula_etapa")
  @@map("matricula")
}

model MatriculaDecisao {
  id          BigInt    @id @default(autoincrement())
  matriculaId BigInt    @map("matricula_id")
  usuarioId   BigInt    @map("usuario_id")
  etapa       String    @db.VarChar(20)
  resultado   String    @db.VarChar(30)
  parecer     String?   @db.Text
  decididoEm  DateTime  @default(now()) @map("decidido_em") @db.DateTime(0)
  matricula   Matricula @relation(fields: [matriculaId], references: [id], onDelete: Cascade, map: "fk_matricula_decisao_matricula")
  usuario     Usuario   @relation(fields: [usuarioId], references: [id], onDelete: NoAction, map: "fk_matricula_decisao_usuario")

  @@index([matriculaId, decididoEm], map: "idx_matricula_decisao_matricula_data")
  @@index([usuarioId], map: "idx_matricula_decisao_usuario")
  @@map("matricula_decisao")
}

model PasswordSetupToken {
  id        BigInt             @id @default(autoincrement())
  usuarioId BigInt             @map("usuario_id")
  tokenHash String             @unique(map: "uk_password_setup_token_hash") @map("token_hash") @db.VarChar(255)
  expiraEm  DateTime           @map("expira_em") @db.DateTime(0)
  usadoEm   DateTime?          @map("usado_em") @db.DateTime(0)
  criadoEm  DateTime           @default(now()) @map("criado_em") @db.DateTime(0)
  tipo      TipoPasswordSetup?
  usuario   Usuario            @relation(fields: [usuarioId], references: [id], onDelete: Cascade, map: "fk_password_setup_token_usuario")

  @@index([usuarioId, expiraEm], map: "idx_password_setup_token_usuario_expira")
  @@map("password_setup_token")
}

model Catequizando {
  id                 BigInt      @id @default(autoincrement())
  matriculaId        BigInt?     @unique(map: "matricula_id") @map("matricula_id")
  responsavelId      BigInt      @map("responsavel_id")
  turmaId            BigInt?     @map("turma_id")
  nome               String      @db.VarChar(150)
  dataNascimento     DateTime    @map("data_nascimento") @db.Date
  sexo               String?     @db.VarChar(20)
  endereco           String?     @db.Text
  telefoneEmergencia String?     @map("telefone_emergencia") @db.VarChar(20)
  situacao           String?     @db.VarChar(50)
  dataIngresso       DateTime?   @map("data_ingresso") @db.Date
  matricula          Matricula?  @relation(fields: [matriculaId], references: [id], onDelete: NoAction, map: "fk_catequizando_matricula")
  responsavel        Responsavel @relation(fields: [responsavelId], references: [id], onDelete: NoAction, map: "fk_catequizando_responsavel")
  turma              Turma?      @relation(fields: [turmaId], references: [id], onDelete: NoAction, map: "fk_catequizando_turma")

  sacramentos   Sacramento[]
  frequencias   Frequencia[]
  reposicoes    CatequizandoReposicao[]
  participacoes ParticipacaoEvento[]

  @@index([responsavelId], map: "fk_catequizando_responsavel")
  @@index([turmaId], map: "fk_catequizando_turma")
  @@map("catequizando")
}

model Turma {
  id      BigInt           @id @default(autoincrement())
  etapaId BigInt           @map("etapa_id")
  nome    String           @db.VarChar(150)
  ano     Int
  horario String?          @db.VarChar(50)
  local   String?          @db.VarChar(150)
  ativa   Boolean?         @default(true)
  etapa   EtapaCatequetica @relation(fields: [etapaId], references: [id], onDelete: NoAction, map: "fk_turma_etapa")

  catequizandos Catequizando[]
  catequistas   TurmaCatequista[]
  encontros     EncontroCatequetico[]
  eventos       Evento[]
  comunicados   Comunicado[]

  @@index([etapaId], map: "fk_turma_etapa")
  @@map("turma")
}

model EtapaCatequetica {
  id        BigInt   @id @default(autoincrement())
  nome      String   @db.VarChar(150)
  descricao String?  @db.Text
  ordem     Int
  ativa     Boolean? @default(true)

  turmas     Turma[]
  matriculas Matricula[]
  conteudos  EtapaConteudo[]

  @@map("etapa_catequetica")
}

model Documento {
  id            BigInt    @id @default(autoincrement())
  matriculaId   BigInt    @map("matricula_id")
  nomeArquivo   String    @map("nome_arquivo") @db.VarChar(255)
  tipoDocumento String    @map("tipo_documento") @db.VarChar(100)
  status        String    @db.VarChar(30)
  parecer       String?   @db.Text
  dataEnvio     DateTime? @default(now()) @map("data_envio") @db.DateTime(0)
  matricula     Matricula @relation(fields: [matriculaId], references: [id], onDelete: Cascade, map: "fk_documento_matricula")

  @@index([matriculaId], map: "fk_documento_matricula")
  @@map("documento")
}

model Evento {
  id            BigInt               @id @default(autoincrement())
  turmaId       BigInt?              @map("turma_id")
  titulo        String               @db.VarChar(200)
  descricao     String?              @db.Text
  dataEvento    DateTime             @map("data_evento") @db.DateTime(0)
  local         String?              @db.VarChar(150)
  obrigatorio   Boolean?             @default(true)
  turma         Turma?               @relation(fields: [turmaId], references: [id], onDelete: NoAction, map: "fk_evento_turma")
  participacoes ParticipacaoEvento[]

  @@index([turmaId], map: "fk_evento_turma")
  @@map("evento")
}

model Comunicado {
  id             BigInt    @id @default(autoincrement())
  usuarioId      BigInt    @map("usuario_id")
  turmaId        BigInt?   @map("turma_id")
  tipoComunicado String    @map("tipo_comunicado") @db.VarChar(20)
  titulo         String    @db.VarChar(200)
  conteudo       String    @db.Text
  dataPublicacao DateTime? @default(now()) @map("data_publicacao") @db.DateTime(0)
  usuario        Usuario   @relation(fields: [usuarioId], references: [id], onDelete: NoAction, map: "fk_comunicado_usuario")
  turma          Turma?    @relation(fields: [turmaId], references: [id], onDelete: NoAction, map: "fk_comunicado_turma")

  @@index([usuarioId], map: "fk_comunicado_usuario")
  @@index([turmaId], map: "fk_comunicado_turma")
  @@map("comunicado")
}

model Frequencia {
  id             BigInt              @id @default(autoincrement())
  catequizandoId BigInt              @map("catequizando_id")
  encontroId     BigInt              @map("encontro_id")
  status         String              @db.VarChar(30)
  dataRegistro   DateTime?           @default(now()) @map("data_registro") @db.DateTime(0)
  catequizando   Catequizando        @relation(fields: [catequizandoId], references: [id], onDelete: NoAction, map: "fk_freq_catequizando")
  encontro       EncontroCatequetico @relation(fields: [encontroId], references: [id], onDelete: NoAction, map: "fk_freq_encontro")
  justificativas Justificativa[]

  @@unique([catequizandoId, encontroId], map: "uk_frequencia")
  @@index([encontroId], map: "fk_freq_encontro")
  @@map("frequencia")
}

model Reposicao {
  id            BigInt                  @id @default(autoincrement())
  data          DateTime                @db.Date
  local         String?                 @db.VarChar(150)
  observacao    String?                 @db.Text
  catequizandos CatequizandoReposicao[]

  @@map("reposicao")
}

model Justificativa {
  id                 BigInt     @id @default(autoincrement())
  frequenciaId       BigInt     @map("frequencia_id")
  motivo             String     @db.Text
  arquivoComprovante String?    @map("arquivo_comprovante") @db.VarChar(255)
  analise            String?    @db.Text
  status             String?    @default("PENDENTE") @db.VarChar(30)
  dataEnvio          DateTime?  @default(now()) @map("data_envio") @db.DateTime(0)
  frequencia         Frequencia @relation(fields: [frequenciaId], references: [id], onDelete: Cascade, map: "fk_justificativa_frequencia")

  @@index([frequenciaId], map: "fk_justificativa_frequencia")
  @@map("justificativa")
}

model Sacramento {
  id              BigInt       @id @default(autoincrement())
  catequizandoId  BigInt       @map("catequizando_id")
  tipo            String       @db.VarChar(50)
  dataRecebimento DateTime?    @map("data_recebimento") @db.Date
  paroquia        String?      @db.VarChar(150)
  comprovante     String?      @db.VarChar(255)
  catequizando    Catequizando @relation(fields: [catequizandoId], references: [id], onDelete: Cascade, map: "fk_sacramento_catequizando")

  @@index([catequizandoId], map: "fk_sacramento_catequizando")
  @@map("sacramento")
}

model MaterialApoio {
  id         BigInt              @id @default(autoincrement())
  conteudoId BigInt              @map("conteudo_id")
  titulo     String              @db.VarChar(150)
  categoria  String?             @db.VarChar(100)
  arquivo    String?             @db.VarChar(255)
  conteudo   ConteudoCatequetico @relation(fields: [conteudoId], references: [id], onDelete: Cascade, map: "fk_material_conteudo")

  @@index([conteudoId], map: "fk_material_conteudo")
  @@map("material_apoio")
}

model ConteudoCatequetico {
  id          BigInt    @id @default(autoincrement())
  titulo      String    @db.VarChar(200)
  descricao   String?   @db.Text
  dataCriacao DateTime? @default(now()) @map("data_criacao") @db.DateTime(0)

  etapas            EtapaConteudo[]
  materiais         MaterialApoio[]
  disponibilizacoes DisponibilizacaoConteudo[]
  encontros         EncontroCatequetico[]

  @@map("conteudo_catequetico")
}

model DisponibilizacaoConteudo {
  id                   BigInt              @id @default(autoincrement())
  conteudoId           BigInt              @map("conteudo_id")
  catequistaId         BigInt              @map("catequista_id")
  usuarioLiberadorId   BigInt              @map("usuario_liberador_id")
  dataDisponibilizacao DateTime?           @default(now()) @map("data_disponibilizacao") @db.DateTime(0)
  ativo                Boolean?            @default(true)
  observacao           String?             @db.Text
  conteudo             ConteudoCatequetico @relation(fields: [conteudoId], references: [id], onDelete: NoAction, map: "fk_disp_conteudo")
  catequista           Catequista          @relation(fields: [catequistaId], references: [id], onDelete: NoAction, map: "fk_disp_catequista")
  usuarioLiberador     Usuario             @relation(fields: [usuarioLiberadorId], references: [id], onDelete: NoAction, map: "fk_disp_usuario")

  @@index([conteudoId], map: "fk_disp_conteudo")
  @@index([catequistaId], map: "fk_disp_catequista")
  @@index([usuarioLiberadorId], map: "fk_disp_usuario")
  @@map("disponibilizacao_conteudo")
}

model EncontroCatequetico {
  id          BigInt              @id @default(autoincrement())
  turmaId     BigInt              @map("turma_id")
  conteudoId  BigInt              @map("conteudo_id")
  data        DateTime            @db.Date
  tema        String?             @db.VarChar(200)
  observacoes String?             @db.Text
  turma       Turma               @relation(fields: [turmaId], references: [id], onDelete: NoAction, map: "fk_encontro_turma")
  conteudo    ConteudoCatequetico @relation(fields: [conteudoId], references: [id], onDelete: NoAction, map: "fk_encontro_conteudo")

  frequencias Frequencia[]

  @@index([turmaId], map: "fk_encontro_turma")
  @@index([conteudoId], map: "fk_encontro_conteudo")
  @@map("encontro_catequetico")
}

model EtapaConteudo {
  etapaId    BigInt              @map("etapa_id")
  conteudoId BigInt              @map("conteudo_id")
  etapa      EtapaCatequetica    @relation(fields: [etapaId], references: [id], onDelete: Cascade, map: "fk_ec_etapa")
  conteudo   ConteudoCatequetico @relation(fields: [conteudoId], references: [id], onDelete: Cascade, map: "fk_ec_conteudo")

  @@id([etapaId, conteudoId])
  @@index([conteudoId], map: "fk_ec_conteudo")
  @@map("etapa_conteudo")
}

model ParticipacaoEvento {
  eventoId       BigInt       @map("evento_id")
  catequizandoId BigInt       @map("catequizando_id")
  presente       Boolean?     @default(false)
  evento         Evento       @relation(fields: [eventoId], references: [id], onDelete: Cascade, map: "fk_pe_evento")
  catequizando   Catequizando @relation(fields: [catequizandoId], references: [id], onDelete: Cascade, map: "fk_pe_catequizando")

  @@id([eventoId, catequizandoId])
  @@index([catequizandoId], map: "fk_pe_catequizando")
  @@map("participacao_evento")
}

model CatequizandoReposicao {
  catequizandoId BigInt       @map("catequizando_id")
  reposicaoId    BigInt       @map("reposicao_id")
  catequizando   Catequizando @relation(fields: [catequizandoId], references: [id], onDelete: Cascade, map: "fk_cr_catequizando")
  reposicao      Reposicao    @relation(fields: [reposicaoId], references: [id], onDelete: Cascade, map: "fk_cr_reposicao")

  @@id([catequizandoId, reposicaoId])
  @@index([reposicaoId], map: "fk_cr_reposicao")
  @@map("catequizando_reposicao")
}

model TurmaCatequista {
  turmaId      BigInt     @map("turma_id")
  catequistaId BigInt     @map("catequista_id")
  turma        Turma      @relation(fields: [turmaId], references: [id], onDelete: Cascade, map: "fk_tc_turma")
  catequista   Catequista @relation(fields: [catequistaId], references: [id], onDelete: Cascade, map: "fk_tc_catequista")

  @@id([turmaId, catequistaId])
  @@index([catequistaId], map: "fk_tc_catequista")
  @@map("turma_catequista")
}

model Mensagem {
  id             BigInt    @id @default(autoincrement())
  remetenteId    BigInt    @map("remetente_id")
  destinatarioId BigInt    @map("destinatario_id")
  texto          String    @db.Text
  lida           Boolean?  @default(false)
  dataEnvio      DateTime? @default(now()) @map("data_envio") @db.DateTime(0)
  remetente      Usuario   @relation("MensagemRemetente", fields: [remetenteId], references: [id], onDelete: NoAction, map: "fk_msg_remetente")
  destinatario   Usuario   @relation("MensagemDestinatario", fields: [destinatarioId], references: [id], onDelete: NoAction, map: "fk_msg_destinatario")

  @@index([remetenteId], map: "fk_msg_remetente")
  @@index([destinatarioId], map: "fk_msg_destinatario")
  @@map("mensagem")
}
