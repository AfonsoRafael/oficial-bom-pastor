# Environment
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://catequese_user:senha_forte@localhost:5432/catequese_db

# JWT
JWT_SECRET=seu_secret_muito_seguro_aqui_mude_em_producao
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=seu_refresh_secret_muito_seguro_aqui
JWT_REFRESH_EXPIRATION=7d

# S3 / Cloudflare R2 / AWS S3
S3_REGION=auto
S3_BUCKET=seu-bucket
S3_ACCESS_KEY_ID=xxx
S3_SECRET_ACCESS_KEY=xxx
S3_ENDPOINT=https://seu-r2-endpoint.com
S3_PUBLIC_ENDPOINT=http://localhost:9000

# Email SMTP (obrigatorio para enviar convites de criação de senha)
SMTP_HOST=smtp.seuprovedor.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu-usuario-smtp
SMTP_PASS=sua-senha-smtp
SMTP_FROM=Portal de Catequese <noreply@catequesebompastor.com>

# Pagamento (opcional)
STRIPE_API_KEY=xxx
MERCADO_PAGO_KEY=xxx

# Frontend URLs (para CORS, separados por virgula)
FRONTEND_URLS=http://localhost:8080,http://localhost:8081,http://localhost:5173

# Compatibilidade: se FRONTEND_URLS nao estiver definido, FRONTEND_URL sera usado
FRONTEND_URL=http://localhost:8080
